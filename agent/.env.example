# ─── HTTP API（上线时 ALLOWED_ORIGIN 改成 Vercel 域名）───
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGIN=http://localhost:3000

# ─── Cobo Agentic Wallet（caw onboard 后从 ~/.cobo-agentic-wallet 凭证取）───
AGENT_WALLET_API_URL=https://api.agenticwallet.cobo.com
AGENT_WALLET_API_KEY=your_cobo_agentic_wallet_api_key
AGENT_WALLET_WALLET_UUID=your_cobo_wallet_uuid

# ─── agentSigner（合约只认这个地址签的名，必须等于链上 agentSigner()）───
# local=AGENT_PRIVATE_KEY 签 proof；cobo=CAW messageSign 签 proof，需先 setAgentSigner(CAW_SRC_ADDRESS)
SIGNER_MODE=cobo
AGENT_PRIVATE_KEY=0xyour_agent_private_key

# ─── AI 评分审批阈值（签 Cobo proof 前执行）───
SCORE_REVIEW_THRESHOLD=80
CONTRIBUTOR_ROUND_SCORE_REVIEW_THRESHOLD=120
CONTRIBUTOR_DAILY_SUBMISSION_REVIEW_THRESHOLD=3
COBO_APPROVAL_SYNC_ENABLED=true

# ─── 证据化评分（均可选；不填 AI key 时仍使用规则评分）───
GITHUB_TOKEN=
AI_SCORER_PROVIDER=openai
AI_SCORER_MODEL=
AI_SCORER_API_KEY=your_ai_scorer_api_key
AI_SCORER_BASE_URL=https://api.openai.com/v1/chat/completions

# ─── 合约（Sepolia，以合约负责人最新部署日志为准）───
POOL_ADDRESS=0x876A0741223EDdaE081Ef22beA513E92335B1Bd5
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
PROJECT_ID=1
ROUND_ID=1
CHAIN_ID=11155111
COBO_CHAIN_ID=SETH
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── CAW 当 executor 发交易 / 签 proof（SDK + 预建 Pact）───
# 先运行 `npm run prepare:pacts` 提交 Main/Sign/Guard Pact，再去 Cobo Agent Wallet App approve。
# 如需 CAW treasury 注资，再运行 `npm run prepare:pacts -- --include=fund` 或 `--only=fund`。
# approve 后把脚本打印的 Pact ID 填到对应变量。
# CAW_PACT_ID：主线执行，只允许 ContributionPool recordContributionBySig / claimFor。
# CAW_SIGN_PACT_ID：EIP-712 ContributionProof messageSign。
# CAW_FUND_PACT_ID：可选 CAW treasury 注资，只允许 USDC approve + ContributionPool fundRound。
# CAW_GUARD_PACT_ID：transfer denied 演示。
# CAW_SRC_ADDRESS：Cobo Agent Wallet 的 EVM 地址。
CAW_PACT_ID=
CAW_SIGN_PACT_ID=
CAW_FUND_PACT_ID=
# 仅兼容旧的“大 Main Pact”。新配置保持 false，避免 Sign/Fund 缺失时悄悄复用 CAW_PACT_ID。
CAW_LEGACY_COMBINED_PACT=false
CAW_SRC_ADDRESS=
CLAIM_MAX_AMOUNT=100
# 录制演示时建议保持较短，避免 Cobo/RPC 网络波动导致页面长时间停在领取中。
CAW_CLAIM_REQUEST_TIMEOUT_MS=18000
CAW_CLAIM_WAIT_TIMEOUT_MS=20000
CAW_GUARD_PACT_ID=
CAW_GUARD_TOKEN_ID=SETH_USDC
CAW_GUARD_DESTINATION=

# ─── 真实 denied 来源：Agent 启动后自动尝试一次超额 transfer，需真实 Cobo Policy 拦截 ───
# 默认关闭，Demo/线上凭证环境确认 guard pact 后再开启。
GUARD_PROBE_ENABLED=false
# 不填则自动使用 CLAIM_MAX_AMOUNT + 1。
GUARD_PROBE_AMOUNT=

# ─── Agent 自主 claim loop（默认关闭，Demo 前填贡献者地址再开启）───
AUTO_CLAIM_ENABLED=false
AUTO_CLAIM_INTERVAL_MS=10000
AUTO_CLAIM_CONTRIBUTORS=
AUTO_CLAIM_MIN_PENDING=1

# ─── Cobo payment(x402) ───
# /api/cobo/pay-x402 复用 AGENT_WALLET_API_KEY / WALLET_UUID，无需额外前端变量。
